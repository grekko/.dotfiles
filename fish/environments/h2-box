# h2-box — always-on server / CI runner (a full macOS install; the ci
# account needs a real GUI session for simulators).
# Sibling profile: fish/environments/h3-2026 (workstation). They are expected
# to diverge; if you fix something here that both need, port it by hand.

# Make `subl` bin available
fish_add_path --prepend --global "/Applications/Sublime Text.app/Contents/SharedSupport/bin"

# Set vim as primary editor
set -x EDITOR nvim

# Bundler
set -x BUNDLER_JOB_SIZE 4

# Configure locale to EN
set -x LC_ALL en_US.UTF-8
set -x LC_CTYPE en_US.UTF-8

# Boot homebrew
fish_add_path /opt/homebrew/bin
eval (/opt/homebrew/bin/brew shellenv)

# mise: per-directory tool versions (.tool-versions / mise.toml)
/opt/homebrew/bin/mise activate fish | source

# Direnv
direnv hook fish | source

# Starship
starship init fish | source

fish_add_path --global --prepend ~/.local/bin ~/.dotfiles/bin

# fish_user_paths (above) outranks mise's PATH insertion, so homebrew's node
# would shadow the mise-managed one. Shims first fixes the order.
fish_add_path --global --prepend ~/.local/share/mise/shims

# Android SDK — shared, root-owned, readable by the `ci` runner account.
# Kept out of any $HOME so both accounts see the same install.
set -x ANDROID_HOME /opt/android-sdk
set -x ANDROID_SDK_ROOT /opt/android-sdk
fish_add_path --global /opt/android-sdk/platform-tools

# SSH support pgcli
function pg_ssh
  ssh -f -o ExitOnForwardFailure=yes -L 9432:localhost:5433 $argv sleep 10; pgcli service=pg_ssh_$argv --pgclirc ~/.config/pgcli/config
end

# pgcli helper
function pg
  pgcli service=$argv --pgclirc ~/.config/pgcli/config
end

# OrbStack: command-line tools and integration
source ~/.orbstack/shell/init2.fish 2>/dev/null || :
