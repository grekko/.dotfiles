# Ghostty config — migrated from iTerm2 (Default profile)
# Reload after edit: Cmd+Shift+, (or restart Ghostty)

# --- shell ---
command = /opt/homebrew/bin/fish

# --- font ---
font-family = "Hack Nerd Font Mono"
font-size = 12
font-thicken = true

# --- colors ---
theme = "GitHub Dark High Contrast"
minimum-contrast = 3

# --- fullscreen (no native macOS Space/animation) ---
macos-non-native-fullscreen = true

# --- behavior ---
cursor-style-blink = false
mouse-hide-while-typing = true

# --- niceties (Ghostty defaults, uncomment to change) ---
# macos-titlebar-style = tabs
# copy-on-select = clipboard
