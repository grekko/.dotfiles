#!/usr/bin/env bash
#
# Sync all claude worktrees with latest main and run pending migrations.
#
# For each worktree under the same .git whose basename starts with
# `tame-health.headacy-app-claude`:
#   1. Stash any uncommitted changes.
#   2. Check out the dedicated branch (same name as the worktree basename),
#      rebase onto origin/main.
#   3. Return to the branch that was checked out originally, pop the stash.
#   4. Run bin/rails db:migrate (all worktrees share headacy-app_development).
#
# Usage: script/claude-sync-worktree
# Runnable from any worktree.
#
set -uo pipefail

log() { printf '\033[1;34m==>\033[0m %s\n' "$*"; }
warn() { printf '\033[1;33m[warn]\033[0m %s\n' "$*" >&2; }
err()  { printf '\033[1;31m[err]\033[0m  %s\n' "$*" >&2; }

THIS_WT="$(pwd)"

# First entry of `git worktree list --porcelain` is the main worktree.
MAIN_WT="$(git -C "$THIS_WT" worktree list --porcelain | awk '/^worktree /{print $2; exit}')"

if [ -z "${MAIN_WT:-}" ] || [ ! -d "$MAIN_WT" ]; then
  err "could not locate main worktree"
  exit 1
fi

log "main worktree: $MAIN_WT"

# Refuse to run if any worktree has an in-progress rebase/merge/cherry-pick.
for state_dir in "$(git -C "$MAIN_WT" rev-parse --git-common-dir)"/worktrees/*; do
  [ -d "$state_dir" ] || continue
  for f in rebase-merge rebase-apply MERGE_HEAD CHERRY_PICK_HEAD; do
    if [ -e "$state_dir/$f" ]; then
      err "worktree $(basename "$state_dir") has in-progress $f; aborting"
      exit 1
    fi
  done
done
for f in rebase-merge rebase-apply MERGE_HEAD CHERRY_PICK_HEAD; do
  if [ -e "$(git -C "$MAIN_WT" rev-parse --git-dir)/$f" ]; then
    err "main worktree has in-progress $f; aborting"
    exit 1
  fi
done

log "fetching origin"
git -C "$MAIN_WT" fetch --prune origin

# Fast-forward main worktree's main branch if clean and on main.
main_branch="$(git -C "$MAIN_WT" symbolic-ref --short HEAD 2>/dev/null || true)"
if [ "$main_branch" = "main" ] && [ -z "$(git -C "$MAIN_WT" status --porcelain)" ]; then
  log "fast-forwarding $MAIN_WT (main) to origin/main"
  if ! git -C "$MAIN_WT" merge --ff-only origin/main; then
    warn "could not fast-forward main; continuing"
  fi
else
  warn "main worktree not on a clean 'main'; skipping ff (branch=$main_branch)"
fi

# Collect claude worktrees (basename starts with tame-health.headacy-app-claude).
mapfile -t CLAUDE_WTS < <(
  git -C "$MAIN_WT" worktree list --porcelain \
    | awk '/^worktree /{print $2}' \
    | while read -r wt; do
        base="$(basename "$wt")"
        case "$base" in
          tame-health.headacy-app-claude|tame-health.headacy-app-claude-*) echo "$wt" ;;
        esac
      done
)

if [ "${#CLAUDE_WTS[@]}" -eq 0 ]; then
  warn "no claude worktrees found"
  exit 0
fi

SUCCESS=()
FAILED=()
WARNED=()

sync_worktree() {
  local wt="$1"
  local base branch orig_branch stashed=0 switched=0
  base="$(basename "$wt")"
  branch="$base"

  log "syncing $base"

  # Capture original HEAD (branch name, or bare SHA if detached).
  if orig_branch="$(git -C "$wt" symbolic-ref --short HEAD 2>/dev/null)"; then
    :
  else
    orig_branch="$(git -C "$wt" rev-parse HEAD)"
    warn "  $base is in detached HEAD ($orig_branch); will return to same commit"
  fi

  # Stash if dirty.
  if [ -n "$(git -C "$wt" status --porcelain)" ]; then
    log "  stashing uncommitted changes"
    if ! git -C "$wt" stash push --include-untracked -m "claude-sync-worktree $(date +%s)"; then
      err "  stash failed; skipping $base"
      FAILED+=("$base (stash failed)")
      return
    fi
    stashed=1
  fi

  # Ensure dedicated branch exists, switch to it if needed.
  if ! git -C "$wt" rev-parse --verify "refs/heads/$branch" >/dev/null 2>&1; then
    log "  creating $branch from origin/main"
    if ! git -C "$wt" branch "$branch" origin/main; then
      err "  could not create $branch; restoring state"
      [ "$stashed" = 1 ] && git -C "$wt" stash pop || true
      FAILED+=("$base (branch create failed)")
      return
    fi
  fi

  if [ "$orig_branch" != "$branch" ]; then
    if ! git -C "$wt" checkout "$branch"; then
      err "  checkout $branch failed; restoring state"
      [ "$stashed" = 1 ] && git -C "$wt" stash pop || true
      FAILED+=("$base (checkout failed)")
      return
    fi
    switched=1
  fi

  # Rebase onto origin/main.
  log "  rebasing $branch onto origin/main"
  if ! git -C "$wt" rebase origin/main; then
    err "  rebase conflict; aborting"
    git -C "$wt" rebase --abort || true
    if [ "$switched" = 1 ]; then
      git -C "$wt" checkout "$orig_branch" || true
    fi
    [ "$stashed" = 1 ] && git -C "$wt" stash pop || true
    FAILED+=("$base (rebase conflict)")
    return
  fi

  # Return to original branch if we switched.
  if [ "$switched" = 1 ]; then
    if ! git -C "$wt" checkout "$orig_branch"; then
      err "  could not return to $orig_branch"
      FAILED+=("$base (checkout back failed)")
      return
    fi
  fi

  # Pop stash.
  if [ "$stashed" = 1 ]; then
    if ! git -C "$wt" stash pop; then
      warn "  stash pop had conflicts; resolve manually in $wt"
      WARNED+=("$base (stash pop conflict)")
    fi
  fi

  # Run pending migrations (all worktrees share headacy-app_development).
  log "  running db:migrate"
  if ! "$wt/bin/rails" db:migrate; then
    err "  db:migrate failed"
    FAILED+=("$base (db:migrate failed)")
    return
  fi

  SUCCESS+=("$base")
}

for wt in "${CLAUDE_WTS[@]}"; do
  sync_worktree "$wt"
done

# Final step: leave the invoking worktree on its named branch, with all
# remotes fetched and the branch rebased on top of local main.
finalize_cwd_worktree() {
  local wt="$THIS_WT"
  local base branch
  base="$(basename "$wt")"
  branch="$base"

  log "finalizing invoking worktree: $base"

  if ! git -C "$wt" rev-parse --verify "refs/heads/$branch" >/dev/null 2>&1; then
    warn "  no $branch branch in $wt; skipping finalize"
    WARNED+=("$base (finalize: no $branch branch)")
    return
  fi

  if [ -n "$(git -C "$wt" status --porcelain)" ]; then
    warn "  $base is dirty; skipping finalize (run again on a clean tree)"
    WARNED+=("$base (finalize: dirty tree)")
    return
  fi

  if ! git -C "$wt" checkout "$branch"; then
    err "  could not check out $branch"
    FAILED+=("$base (finalize: checkout failed)")
    return
  fi

  log "  git fetch --all"
  if ! git -C "$wt" fetch --all --prune; then
    warn "  fetch --all failed"
    WARNED+=("$base (finalize: fetch --all failed)")
  fi

  log "  git rebase origin/main"
  if ! git -C "$wt" rebase origin/main; then
    err "  rebase origin/main failed; aborting"
    git -C "$wt" rebase --abort || true
    FAILED+=("$base (finalize: rebase failed)")
  fi
}

finalize_cwd_worktree

echo
log "summary"
for s in "${SUCCESS[@]:-}"; do [ -n "$s" ] && echo "  ok:   $s"; done
for w in "${WARNED[@]:-}";  do [ -n "$w" ] && echo "  warn: $w"; done
for f in "${FAILED[@]:-}";  do [ -n "$f" ] && echo "  fail: $f"; done

[ "${#FAILED[@]}" -eq 0 ]
