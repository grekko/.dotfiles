#!/usr/bin/env bash
# tmuxp-sync-session — freeze the current tmux session to its tmuxp config
# file in ~/.dotfiles/dotdirs/.config/tmuxp/
#
# Usage: tmuxp-sync-session [SESSION_NAME]
#   SESSION_NAME  tmux session name (defaults to current session)

set -euo pipefail

TMUXP_DIR="${HOME}/.dotfiles/dotdirs/.config/tmuxp"

if [[ $# -ge 1 ]]; then
  SESSION="$1"
else
  if [[ -z "${TMUX:-}" ]]; then
    echo "Error: not inside a tmux session and no session name provided." >&2
    exit 1
  fi
  SESSION="$(tmux display-message -p '#S')"
fi

# Verify session exists
if ! tmux has-session -t "$SESSION" 2>/dev/null; then
  echo "Error: tmux session '${SESSION}' not found." >&2
  exit 1
fi

OUTPUT="${TMUXP_DIR}/${SESSION}.yml"

if [[ -f "$OUTPUT" ]]; then
  echo "Overwriting existing config: ${OUTPUT}"
else
  echo "Creating new config: ${OUTPUT}"
fi

tmuxp freeze "$SESSION" -f yaml -o "$OUTPUT" -y --force --quiet

echo "Session '${SESSION}' frozen to ${OUTPUT}"
